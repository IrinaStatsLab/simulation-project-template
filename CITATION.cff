    given-names: Irina
    affiliation: "Department of Biostatistics, University of Michigan"
    orcid: "https://orcid.org/0000-0002-4116-0268"
license: CC-BY-4.0
repository-code: "https://github.com/IrinaStatsLab/simulation-project-template"
keywords:
